# Texte normalisé en LF. Pas de eol=crlf: ça rendait infra/mcp-docker/diag_mcp.cmd "modifié".
* text=auto eol=lf
# Données et scripts Windows déjà versionnés avec leurs octets d'origine (certains blobs sont en CRLF):
# jamais renormalisés.
*.qpl -text
*.csv -text
*.sql -text
*.SQL -text
*.xml -text
*.cmd -text
dossiers/** -text
eewin/** -text
